# Copy to deploy/.env (git-ignored) and fill in. docker compose refuses to start
# while the required values are missing, and the API refuses to start in
# production with default or weak secrets.

# Public hostnames; Caddy obtains TLS certificates for both.
COVAFLUX_DOMAIN=covaflux.example.com
HEADSCALE_DOMAIN=headscale.example.com

# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Initial admin account (>= 12 chars, not a published default). If an existing
# admin still uses a published default password, it is replaced with this value
# at startup.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Extra browser origins allowed to call the API (comma-separated). Leave empty
# when the web UI is served by this stack (same origin).
CORS_ORIGINS=

# Headscale API key used by CovaFlux: lifetime and automatic rotation age.
HEADSCALE_API_KEY_EXPIRATION=90d
HEADSCALE_API_KEY_ROTATE_AFTER_DAYS=60
